# Copy to .env and fill in. Vite inlines VITE_* at build time, so restart the dev
# server after any change here.

# API
VITE_API_BASE_URL=https://rental-uat.lockated.com

# PostHog analytics. Without the token every event is dropped and main.tsx logs an error.
VITE_POSTHOG_PROJECT_TOKEN=phc_replace_me
VITE_POSTHOG_HOST=https://posthog.lockated.com

# Stamped on every event as release_version; set from CI (e.g. the git tag or short SHA).
VITE_APP_VERSION=dev

# Analytics dashboard (/analytics) — PostHog Adoption Analytics service.
# Defaults: https://posthog-api.lockated.com, tenant resolved from the hostname.
VITE_LM_ANALYTICS_API_URL=https://posthog-api.lockated.com
# Scope: by default every query is filtered by project_code (stamped on every event).
# Set VITE_LM_ANALYTICS_TENANT_URL instead to scope by a single host.
VITE_LM_ANALYTICS_PROJECT_CODE=LMV-01
# By default the dashboard sends project_code plus the browser host as url.
# Pin a single host here when a deployment must report against one origin only:
# VITE_LM_ANALYTICS_TENANT_URL=rental.lockated.com

# Licensed Admin seats — billing data, not events. Without it Seat Utilisation shows the
# live active-seat count instead of a percentage.
# VITE_LM_LICENSED_SEATS=55
